          },
          { "text": "比率尺度", "why": "原点0と比の意味があると勘違い" },
          { "text": "名義尺度", "why": "大小の順序が存在するため順序尺度" }
        ],
        "steps": [
          "大小関係だけが意味を持つ → 順序尺度。名義尺度は分類のみ（血液型など）。"
        ]
      },
      {
        "text": "摂氏温度（℃）はどの尺度水準か。",
        "choices": [
          { "text": "間隔尺度" },
          {
            "text": "比率尺度",
            "why": "0℃は「温度がない」意味でないので比は無意味"
          },
          {
            "text": "順序尺度",
            "why": "差（10℃差）にも意味があるので間隔尺度"
          },
          { "text": "名義尺度" }
        ],
        "steps": [
          "差に意味があるが0が任意の原点 → 間隔尺度。絶対温度(K)なら比率尺度。"
        ]
      },
      {
        "text": "血液型(A,B,O,AB)はどの尺度水準か。",
        "choices": [
          { "text": "名義尺度" },
          { "text": "順序尺度", "why": "大小関係はない" },
          { "text": "間隔尺度" },
          { "text": "比率尺度" }
        ],
        "steps": ["分類だけで順序も差も意味を持たない → 名義尺度。"]
      },
      {
        "text": "身長・体重・売上高はどの尺度水準か。",
        "choices": [
          { "text": "比率尺度" },
          {
            "text": "間隔尺度",
            "why": "0が絶対原点で「2倍」に意味があるので比率尺度"
          },
          { "text": "順序尺度" },
          { "text": "名義尺度" }
        ],
        "steps": ["真の0があり比に意味がある → 比率尺度。"]
      }
    ]
  },
